{
  "$defs": {
    "AccessRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "VIEW_OWN_FIELD",
            "VIEW_VILLAGE_SUMMARY",
            "VIEW_MANDAL_SUMMARY",
            "VIEW_DISTRICT_SUMMARY",
            "VIEW_DAMAGE_HEATMAP",
            "VIEW_CROP_STATISTICS",
            "VIEW_PARCEL_ANOMALIES",
            "VIEW_PARCEL_DETAILS",
            "CREATE_FIELD_VERIFICATION",
            "EXPORT_AGGREGATE_REPORT",
            "EXPORT_CASE_EVIDENCE"
          ],
          "title": "Action",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "district_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District Code"
        },
        "field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "mandal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mandal Code"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "village_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Village Code"
        }
      },
      "required": [
        "action",
        "purpose"
      ],
      "title": "AccessRequest",
      "type": "object"
    },
    "GovernmentAuthorization": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "authorization_id": {
          "title": "Authorization Id",
          "type": "string"
        },
        "department": {
          "title": "Department",
          "type": "string"
        },
        "designation": {
          "title": "Designation",
          "type": "string"
        },
        "district_codes": {
          "items": {
            "type": "string"
          },
          "title": "District Codes",
          "type": "array"
        },
        "mandal_codes": {
          "items": {
            "type": "string"
          },
          "title": "Mandal Codes",
          "type": "array"
        },
        "officer_id": {
          "title": "Officer Id",
          "type": "string"
        },
        "order_reference": {
          "title": "Order Reference",
          "type": "string"
        },
        "permission_status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "revoked",
            "expired"
          ],
          "title": "Permission Status",
          "type": "string"
        },
        "permissions": {
          "items": {
            "enum": [
              "VIEW_OWN_FIELD",
              "VIEW_VILLAGE_SUMMARY",
              "VIEW_MANDAL_SUMMARY",
              "VIEW_DISTRICT_SUMMARY",
              "VIEW_DAMAGE_HEATMAP",
              "VIEW_CROP_STATISTICS",
              "VIEW_PARCEL_ANOMALIES",
              "VIEW_PARCEL_DETAILS",
              "CREATE_FIELD_VERIFICATION",
              "EXPORT_AGGREGATE_REPORT",
              "EXPORT_CASE_EVIDENCE"
            ],
            "type": "string"
          },
          "title": "Permissions",
          "type": "array"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "village_codes": {
          "items": {
            "type": "string"
          },
          "title": "Village Codes",
          "type": "array"
        }
      },
      "required": [
        "authorization_id",
        "officer_id",
        "department",
        "designation",
        "permission_status",
        "permissions",
        "order_reference",
        "valid_from",
        "valid_until"
      ],
      "title": "GovernmentAuthorization",
      "type": "object"
    },
    "GovernmentConnectorConfig": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "credential_env": {
          "title": "Credential Env",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "meebhoomi",
            "bhunaksha",
            "agristack",
            "authorized_custom"
          ],
          "title": "Provider",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 20,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "base_url",
        "credential_env"
      ],
      "title": "GovernmentConnectorConfig",
      "type": "object"
    },
    "UserContext": {
      "additionalProperties": false,
      "properties": {
        "consent_active": {
          "title": "Consent Active",
          "type": "boolean"
        },
        "owned_field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Owned Field Ids",
          "type": "array"
        },
        "role": {
          "enum": [
            "farmer",
            "government_officer",
            "investigator",
            "admin",
            "agronomist",
            "machinery_operator"
          ],
          "title": "Role",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "role",
        "consent_active"
      ],
      "title": "UserContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access": {
      "$ref": "#/$defs/AccessRequest"
    },
    "authorization": {
      "$ref": "#/$defs/GovernmentAuthorization"
    },
    "config": {
      "$ref": "#/$defs/GovernmentConnectorConfig"
    },
    "params": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Params",
      "type": "object"
    },
    "resource_path": {
      "title": "Resource Path",
      "type": "string"
    },
    "user": {
      "$ref": "#/$defs/UserContext"
    }
  },
  "required": [
    "config",
    "user",
    "access",
    "authorization",
    "resource_path"
  ],
  "title": "GovernmentFetchInput",
  "type": "object"
}
