{
  "$defs": {
    "ConfidenceBreakdown": {
      "additionalProperties": false,
      "properties": {
        "agreement_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Agreement Factor",
          "type": "number"
        },
        "completeness_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness Factor",
          "type": "number"
        },
        "final_confidence_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Final Confidence Pct",
          "type": "number"
        },
        "quality_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Quality Factor",
          "type": "number"
        },
        "raw_confidence_pct": {
          "title": "Raw Confidence Pct",
          "type": "number"
        },
        "sowing_penalty_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Sowing Penalty Pct",
          "type": "number"
        }
      },
      "required": [
        "quality_factor",
        "completeness_factor",
        "agreement_factor",
        "sowing_penalty_pct",
        "raw_confidence_pct",
        "final_confidence_pct"
      ],
      "title": "ConfidenceBreakdown",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "observed": {
          "title": "Observed"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "vote": {
          "enum": [
            "SUPPORTS",
            "OPPOSES",
            "NEUTRAL"
          ],
          "title": "Vote",
          "type": "string"
        }
      },
      "required": [
        "code",
        "observed",
        "rule",
        "vote",
        "source"
      ],
      "title": "EvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_english": {
      "title": "Action English",
      "type": "string"
    },
    "action_telugu": {
      "title": "Action Telugu",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceBreakdown"
    },
    "confidence_tag": {
      "enum": [
        "HIGH_CONFIDENCE",
        "MEDIUM_CONFIDENCE",
        "LOW_CONFIDENCE"
      ],
      "title": "Confidence Tag",
      "type": "string"
    },
    "diagnosed_at": {
      "format": "date-time",
      "title": "Diagnosed At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "false_alarm_suppressed": {
      "title": "False Alarm Suppressed",
      "type": "boolean"
    },
    "field_id": {
      "title": "Field Id",
      "type": "string"
    },
    "ground_verification_required": {
      "title": "Ground Verification Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "CONFIRMED_WATER_STRESS",
        "SUSPECTED_FUNGAL_RISK",
        "NITROGEN_DEFICIENCY_EVIDENCE",
        "NORMAL_MATURITY",
        "NORMAL_OR_UNRESOLVED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "field_id",
    "diagnosed_at",
    "verdict",
    "false_alarm_suppressed",
    "evidence",
    "confidence",
    "confidence_tag",
    "action_telugu",
    "action_english",
    "ground_verification_required"
  ],
  "title": "DiagnosisResult",
  "type": "object"
}
