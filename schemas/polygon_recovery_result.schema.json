{
  "$defs": {
    "BoundaryCandidate": {
      "additionalProperties": false,
      "properties": {
        "area_acres": {
          "exclusiveMinimum": 0,
          "title": "Area Acres",
          "type": "number"
        },
        "area_difference_pct": {
          "minimum": 0,
          "title": "Area Difference Pct",
          "type": "number"
        },
        "area_m2": {
          "exclusiveMinimum": 0,
          "title": "Area M2",
          "type": "number"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "contains_input_point": {
          "title": "Contains Input Point",
          "type": "boolean"
        },
        "geometry_geojson": {
          "additionalProperties": true,
          "title": "Geometry Geojson",
          "type": "object"
        },
        "legal_boundary": {
          "const": false,
          "default": false,
          "title": "Legal Boundary",
          "type": "boolean"
        },
        "model_name": {
          "const": "FTW_PRUE",
          "default": "FTW_PRUE",
          "title": "Model Name",
          "type": "string"
        },
        "perimeter_m": {
          "exclusiveMinimum": 0,
          "title": "Perimeter M",
          "type": "number"
        },
        "point_distance_m": {
          "minimum": 0,
          "title": "Point Distance M",
          "type": "number"
        },
        "quality": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Quality",
          "type": "string"
        },
        "score_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Score Components",
          "type": "object"
        },
        "score_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score Pct",
          "type": "number"
        },
        "source": {
          "enum": [
            "ftw_global_2024",
            "ftw_global_2025"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_confidence": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Confidence"
        },
        "year": {
          "enum": [
            2024,
            2025
          ],
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "source",
        "year",
        "geometry_geojson",
        "area_m2",
        "area_acres",
        "perimeter_m",
        "contains_input_point",
        "point_distance_m",
        "area_difference_pct",
        "score_pct",
        "score_components",
        "quality"
      ],
      "title": "BoundaryCandidate",
      "type": "object"
    },
    "LocationEvidence": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "feature_distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Distance M"
        },
        "feature_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Type"
        },
        "matched_latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Latitude"
        },
        "matched_longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Longitude"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "raw_osm_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Osm Id"
        },
        "raw_osm_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Osm Type"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "source": {
          "enum": [
            "nominatim_live",
            "cache"
          ],
          "title": "Source",
          "type": "string"
        },
        "subdivision_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subdivision Code"
        }
      },
      "required": [
        "source",
        "blocking",
        "reason_code"
      ],
      "title": "LocationEvidence",
      "type": "object"
    },
    "PolygonRecoveryInput": {
      "additionalProperties": false,
      "properties": {
        "acres": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Acres",
          "type": "number"
        },
        "country_code": {
          "default": "IN",
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "field_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Field Id",
          "type": "string"
        },
        "gps_tolerance_m": {
          "default": 30.0,
          "maximum": 100,
          "minimum": 5,
          "title": "Gps Tolerance M",
          "type": "number"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "location_consent": {
          "const": true,
          "title": "Location Consent",
          "type": "boolean"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "search_radius_m": {
          "default": 300.0,
          "maximum": 1000,
          "minimum": 30,
          "title": "Search Radius M",
          "type": "number"
        },
        "subdivision_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subdivision Code"
        }
      },
      "required": [
        "field_id",
        "latitude",
        "longitude",
        "acres",
        "location_consent"
      ],
      "title": "PolygonRecoveryInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/BoundaryCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocationEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request": {
      "$ref": "#/$defs/PolygonRecoveryInput"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Candidate Id"
    },
    "status": {
      "enum": [
        "rejected_location",
        "preflight_unavailable",
        "no_candidate",
        "candidates_found"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request",
    "checked_at",
    "status"
  ],
  "title": "PolygonRecoveryResult",
  "type": "object"
}
