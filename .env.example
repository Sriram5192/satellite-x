# HTTP behavior
SATELLITE_X_CONNECT_TIMEOUT_S=5
SATELLITE_X_READ_TIMEOUT_S=30
SATELLITE_X_RETRIES=2
SATELLITE_X_BACKOFF_FACTOR=0.5
SATELLITE_X_USER_AGENT=Satellite-X/0.1

# Acquisition behavior
SATELLITE_X_MAX_CLOUD_PCT=40
SATELLITE_X_EXPAND_DAYS=30
SATELLITE_X_FORECAST_DAYS=7
SATELLITE_X_IOT_MAX_AGE_HOURS=24

# Polygon recovery gates
SATELLITE_X_ROAD_REJECT_DISTANCE_M=20
SATELLITE_X_STRUCTURE_REJECT_DISTANCE_M=15
SATELLITE_X_WATER_REJECT_DISTANCE_M=15
SATELLITE_X_FTW_MIN_AREA_RATIO=0.2
SATELLITE_X_FTW_MAX_AREA_RATIO=5.0
SATELLITE_X_FTW_QUERY_LIMIT=250
SATELLITE_X_MAX_CANDIDATE_AREA_DIFF_PCT=50
SATELLITE_X_POLYGON_HIGH_SCORE_PCT=85
SATELLITE_X_POLYGON_MEDIUM_SCORE_PCT=65
SATELLITE_X_POLYGON_MAX_CANDIDATES=5

# Set 2 calibrated spectral-validity gate
SATELLITE_X_SPECTRAL_MIN_VALID_PCT=60

SATELLITE_X_CACHE_DIR=runtime/cache

# Optional: payload bytes must be signed with HMAC-SHA256. Never commit the real secret.
SATELLITE_X_IOT_HMAC_SECRET=replace-with-device-secret

# SoilGrids is currently intermittent. The frozen blueprint baseline is used only
# after live SoilGrids and cache both fail; provenance remains explicit.
SATELLITE_X_SOIL_BASELINE_PH=6.8
SATELLITE_X_SOIL_BASELINE_N_G_KG=0.25
